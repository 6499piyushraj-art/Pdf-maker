{
  "name": "paperpilot-pdf-maker",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:vercel": "npx vercel dev --listen 0.0.0.0:3000",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "docx": "^9.5.1",
    "pdfjs-dist": "^5.4.394"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vercel/node": "^5.5.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}