# Server-only Google Gemini API key. Never use a VITE_ prefix for this secret.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
# Choose a model currently enabled for your Google AI Studio API key.
GEMINI_MODEL=gemini-3.8-flash

# Required private-workspace login. Use a unique password with 12+ characters.
APP_PASSWORD=replace_with_a_long_unique_password
# Required signing secret: use a unique random value of at least 32 characters.
# Example generator on a terminal: openssl rand -base64 32
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
