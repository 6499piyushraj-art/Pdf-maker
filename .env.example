# Server-only Google Gemini keys. Never use a VITE_ prefix for these secrets.
# The app tries non-empty numbered slots in order, moving to the next key on request failure.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
# Optional legacy fallback, tried after numbered slots for older deployments.
GEMINI_API_KEY=

# Choose a model currently enabled for all keys, if possible.
GEMINI_MODEL=gemini-3.5-flash-lite

# Required private-workspace login. Use a unique password with 12+ characters.
APP_PASSWORD=replace_with_a_long_unique_password
# Required signing secret: use a unique random value of at least 32 characters.
# Example generator on a terminal: openssl rand -base64 32
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Google Docs OAuth. Enable Google Docs API and create a Web application OAuth client.
# Register this exact URI in Google Cloud Console under Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://paperpilot-pdf-maker.onrender.com/api/google?action=callback
